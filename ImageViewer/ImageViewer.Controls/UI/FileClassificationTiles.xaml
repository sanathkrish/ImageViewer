<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ImageViewer.Controls.UI.FileClassificationTiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageViewer.Controls.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model ="using:ImageViewer.ViewModel.Views"
    mc:Ignorable="d">

    <ScrollViewer >
        <Grid>
            <GridView ItemsSource="{Binding Items}"
IsItemClickEnabled="False" 
SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="model:FileClassificationTileViewModel">
                        <Border Width="150" Height="75" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="#8B93A7" FontSize="10"/>
                                <TextBlock Text="{Binding Count}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SizeString}" Foreground="#6B7280" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </ScrollViewer>
</UserControl>
